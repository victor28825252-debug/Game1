extends SceneTree

func _initialize() -> void:
	call_deferred("run_test")

func run_test() -> void:
	var scene = load("res://main.tscn").instantiate()
	root.add_child(scene)
	await process_frame
	assert(scene.mode == "intro")
	scene._start()
	assert(scene.level == 1 and scene.mode == "explore")
	scene._try_door()
	assert(scene.level == 1 and not scene.key_taken)
	scene._open_quiz()
	scene._answer(false)
	scene._show_hint()
	scene._answer(true)
	assert(not scene.solved and scene.quiz_step == 1)
	scene._answer(true)
	assert(scene.solved and scene.scores[0] == 70)
	scene._try_door()
	assert(scene.level == 1)
	scene._take_key()
	scene._try_door()
	assert(scene.level == 2 and scene.mode == "explore")
	scene._open_quiz()
	scene._answer(true)
	assert(not scene.solved and scene.quiz_step == 1)
	scene._answer(true)
	assert(scene.scores[1] == 100)
	scene._take_key()
	scene._try_door()
	assert(scene.mode == "result")
	assert(scene.previous_scores == [70, 100])
	scene._start()
	assert(scene.level == 1 and scene.mode == "explore")
	scene._open_quiz()
	scene._answer(true)
	scene._answer(true)
	scene._take_key()
	scene._try_door()
	scene._open_quiz()
	scene._answer(true)
	scene._answer(true)
	scene._take_key()
	scene._try_door()
	assert(scene.mode == "result" and scene._difference_text(30) == "進步 30 分")
	print("PASS: two-step transfer, score penalties, keys, locked doors, same-level replay progress")
	quit(0)
